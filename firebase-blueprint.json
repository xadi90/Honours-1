{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student profile and academic preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "selectedDepartmentId": { "type": "string" },
        "selectedDepartmentName": { "type": "string" },
        "selectedYear": { "type": "integer" },
        "languagePreference": { "type": "string", "enum": ["bn_en", "bn", "en"] },
        "savedAnswersCount": { "type": "integer" },
        "bookmarksCount": { "type": "integer" },
        "testsCompletedCount": { "type": "integer" },
        "freeAiLimit": { "type": "integer" },
        "aiUsageCount": { "type": "integer" },
        "purchasedAiCredits": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "selectedDepartmentId", "selectedYear", "createdAt", "updatedAt"]
    },
    "SavedAiAnswer": {
      "title": "SavedAiAnswer",
      "description": "Structured academic answer generated by Firebase AI Logic",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "question": { "type": "string" },
        "answerLength": { "type": "string" },
        "yearLabel": { "type": "string" },
        "subjectName": { "type": "string" },
        "language": { "type": "string" },
        "prashno": { "type": "string" },
        "bhumika": { "type": "string" },
        "mulAlochona": { "type": "string" },
        "importantPoints": { "type": "array" },
        "examples": { "type": "string" },
        "uposhonghar": { "type": "string" },
        "sourceNote": { "type": "string" },
        "hasImageInput": { "type": "boolean" },
        "bookmarked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "question", "prashno", "bhumika", "mulAlochona", "uposhonghar", "createdAt", "updatedAt"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "AI Study Assistant conversation session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "mode": { "type": "string" },
        "subjectName": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "lastMessage": { "type": "string" },
        "messageCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "mode", "createdAt", "updatedAt"]
    },
    "AiMessage": {
      "title": "AiMessage",
      "description": "Message in an AI Study Assistant conversation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "text", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Student bookmark for answers, PDFs, chapters, or PDF pages",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "itemType": { "type": "string", "enum": ["answer", "pdf", "chapter", "pdf_page"] },
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "pageNumber": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "itemType", "targetId", "title", "createdAt", "updatedAt"]
    },
    "ModelTestResult": {
      "title": "ModelTestResult",
      "description": "Completed MCQ or timed model test score record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "testTitle": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "subjectName": { "type": "string" },
        "totalQuestions": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "scorePercent": { "type": "integer" },
        "durationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "testId", "testTitle", "totalQuestions", "correctCount", "scorePercent", "createdAt"]
    },
    "Department": {
      "title": "Department",
      "description": "NU Honours Department entry",
      "type": "object",
      "properties": {
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "hasStructuredSolution": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameBn", "nameEn", "status", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic subject/course under Political Science or another department",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "courseCode": { "type": "string" },
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "credits": { "type": "integer" },
        "syllabusNote": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["departmentId", "yearNumber", "courseCode", "titleBn", "titleEn", "status", "createdAt", "updatedAt"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Chapter-wise academic content",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "chapterNumber": { "type": "integer" },
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "topics": { "type": "array" },
        "summary": { "type": "string" },
        "definitions": { "type": "string" },
        "shortQuestions": { "type": "string" },
        "broadQuestions": { "type": "string" },
        "creativeQuestions": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectId", "yearNumber", "chapterNumber", "titleBn", "status", "createdAt", "updatedAt"]
    },
    "PdfResource": {
      "title": "PdfResource",
      "description": "PDF resource metadata for All Departments PDF Library",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "subjectName": { "type": "string" },
        "courseCode": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "localFileName": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "pageCount": { "type": "integer" },
        "fileSizeBytes": { "type": "integer" },
        "uploadedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["departmentId", "yearNumber", "subjectName", "title", "category", "status", "createdAt", "updatedAt"]
    },
    "StudyQuestion": {
      "title": "StudyQuestion",
      "description": "Previous-year question, suggestion, or MCQ item",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "courseCode": { "type": "string" },
        "questionType": { "type": "string", "enum": ["previous_year", "suggestion", "mcq"] },
        "examYear": { "type": "string" },
        "partLabel": { "type": "string" },
        "prompt": { "type": "string" },
        "answerText": { "type": "string" },
        "options": { "type": "array" },
        "correctOptionIndex": { "type": "integer" },
        "explanation": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["departmentId", "yearNumber", "subjectName", "questionType", "prompt", "status", "createdAt", "updatedAt"]
    },
    "ModelTest": {
      "title": "ModelTest",
      "description": "Timed model test definition",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "title": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "questionCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["departmentId", "yearNumber", "title", "durationMinutes", "status", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "University or app announcement",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "tag": { "type": "string" },
        "pinned": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "status", "createdAt", "updatedAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Student report of incorrect AI answer or content issue",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reporterName": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "reviewed", "resolved", "dismissed"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "targetType", "targetId", "reason", "status", "createdAt", "updatedAt"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Immutable administrator activity log",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminUid", "action", "summary", "createdAt"]
    },
    "AiLimitPurchaseRequest": {
      "title": "AiLimitPurchaseRequest",
      "description": "Student purchase request to buy extra AI question-solving credits",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "packageTitle": { "type": "string" },
        "creditsAmount": { "type": "integer" },
        "priceBdt": { "type": "integer" },
        "paymentMethod": { "type": "string", "enum": ["bKash", "Nagad", "Rocket"] },
        "senderNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "packageTitle", "creditsAmount", "priceBdt", "paymentMethod", "senderNumber", "transactionId", "status", "createdAt", "updatedAt"]
    },
    "CollegeSectionBlock": {
      "title": "CollegeSectionBlock",
      "description": "Admin-customizable modular section or card for Sujat Ali Honours College, Pingna",
      "type": "object",
      "properties": {
        "blockType": { "type": "string", "enum": ["notice", "principal", "department", "routine", "faculty", "admission", "link", "custom"] },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "body": { "type": "string" },
        "badgeText": { "type": "string" },
        "iconKey": { "type": "string", "enum": ["school", "campaign", "schedule", "groups", "book", "info", "phone", "link", "star"] },
        "accentStyle": { "type": "string", "enum": ["primary", "gold", "emerald", "teal", "crimson"] },
        "layoutSpan": { "type": "string", "enum": ["full", "half"] },
        "actionLabel": { "type": "string" },
        "actionUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "pinned": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blockType", "title", "status", "createdAt", "updatedAt"]
    },
    "CollegeModerator": {
      "title": "CollegeModerator",
      "description": "Dedicated moderator allowed to manage only Sujat Ali Honours College, Pingna",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "note": { "type": "string" },
        "active": { "type": "boolean" },
        "addedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "active", "createdAt", "updatedAt"]
    },
    "ChatUserProfile": {
      "title": "ChatUserProfile",
      "description": "Public student chat directory profile containing non-sensitive fields only (no email/phone)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "departmentName": { "type": "string" },
        "yearNumber": { "type": "integer" },
        "photoUrl": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "updatedAt"]
    },
    "UserChatThread": {
      "title": "UserChatThread",
      "description": "Direct 1-on-1 chat thread between two Honours students",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "participantNames": { "type": "object" },
        "participantDepts": { "type": "object" },
        "participantPhotos": { "type": "object" },
        "lastMessageText": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCounts": { "type": "object" },
        "typingUsers": { "type": "object" },
        "blockedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds", "createdAt", "updatedAt"]
    },
    "UserChatMessage": {
      "title": "UserChatMessage",
      "description": "Individual message inside a direct 1-on-1 student chat",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "replyToMessageId": { "type": "string" },
        "replyToSenderName": { "type": "string" },
        "replyToPreview": { "type": "string" },
        "readBy": { "type": "array" },
        "deletedForAll": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/ai_answers/{answerId}": {
      "schema": { "$ref": "#/entities/SavedAiAnswer" },
      "description": "User saved AI question answers"
    },
    "/users/{userId}/ai_conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/AiConversation" },
      "description": "User AI study assistant conversations"
    },
    "/users/{userId}/ai_conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/AiMessage" },
      "description": "Conversation messages"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User bookmarks"
    },
    "/users/{userId}/model_test_results/{resultId}": {
      "schema": { "$ref": "#/entities/ModelTestResult" },
      "description": "User model test score history"
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Dynamic Honours departments"
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Academic subjects/courses"
    },
    "/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Subject chapters and study material"
    },
    "/pdf_library/{pdfId}": {
      "schema": { "$ref": "#/entities/PdfResource" },
      "description": "All-Departments PDF Library metadata"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/StudyQuestion" },
      "description": "Previous-year questions, suggestions, and MCQs"
    },
    "/model_tests/{testId}": {
      "schema": { "$ref": "#/entities/ModelTest" },
      "description": "Timed model tests"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Announcements"
    },
    "/college_sections/{sectionId}": {
      "schema": { "$ref": "#/entities/CollegeSectionBlock" },
      "description": "Customizable sections and cards for Sujat Ali Honours College, Pingna"
    },
    "/user_reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "Student content/AI accuracy reports"
    },
    "/admin_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminLog" },
      "description": "Admin activity log"
    },
    "/ai_purchase_requests/{requestId}": {
      "schema": { "$ref": "#/entities/AiLimitPurchaseRequest" },
      "description": "Student AI limit purchase requests and admin verification status"
    },
    "/college_moderators/{moderatorEmail}": {
      "schema": { "$ref": "#/entities/CollegeModerator" },
      "description": "Dedicated moderators authorized only for Sujat Ali Honours College"
    },
    "/chat_profiles/{userId}": {
      "schema": { "$ref": "#/entities/ChatUserProfile" },
      "description": "Public student chat directory profiles (PII-free)"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/UserChatThread" },
      "description": "Direct 1-on-1 student chat threads"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/UserChatMessage" },
      "description": "Messages inside a direct student chat thread"
    }
  }
}
